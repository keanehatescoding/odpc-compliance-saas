# Postgres connection. Matches docker-compose.yml.
DATABASE_URL=postgres://odpc:odpc@localhost:5432/odpc

# Public base URL, used for links in reminder emails.
APP_URL=http://localhost:3000

# Shared secret for GET /api/cron/reminders (sent as "Authorization: Bearer <secret>").
CRON_SECRET=change-me

# Required in production. Without SMTP_URL, emails are printed to the server log,
# which a production server allows only with EMAIL_LOG_ONLY=true.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=Kinga <reminders@example.com>
# EMAIL_LOG_ONLY=true

# Optional. Where rate limiting reads the client IP. Default: the rightmost
# X-Forwarded-For entry, for one proxy in front of the app. See README "Deploying".
# TRUST_IP_HEADER=x-forwarded-for
# TRUSTED_PROXY_HOPS=1

# Optional. Paystack secret key for subscription payments (M-Pesa and card).
# Point the Paystack webhook at <APP_URL>/api/paystack/webhook. See README "Payments".
# PAYSTACK_SECRET_KEY=sk_test_xxx

# Optional. The business shown on payment receipts. Default name: Kinga.
# Use "\n" for line breaks in the address.
# SELLER_NAME=Kinga Ltd
# SELLER_KRA_PIN=P051234567X
# SELLER_ADDRESS=PO Box 12345-00100\nNairobi
# SELLER_EMAIL=billing@example.com
