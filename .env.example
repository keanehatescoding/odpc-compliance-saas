# Postgres connection. Matches docker-compose.yml.
DATABASE_URL=postgres://odpc:odpc@localhost:5432/odpc

# Public base URL, used for links in reminder emails.
APP_URL=http://localhost:3000

# Shared secret for GET /api/cron/reminders (sent as "Authorization: Bearer <secret>").
CRON_SECRET=change-me

# Optional. Without SMTP_URL, reminder emails are printed to the server log.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=Kinga <reminders@example.com>
